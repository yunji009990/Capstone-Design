TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_TOKEN=replace-with-a-private-worker-token
TTS_BACKEND=vllm_omni
TTS_ENGINE_URL=http://127.0.0.1:8004
TTS_ENGINE_MANAGED=1
TTS_ENGINE_PYTHON=~/venv/qwentts-stream/bin/python
TTS_ENGINE_START_TIMEOUT=600
TTS_ENGINE_WARMUP=1
# 기본 설정은 Server/tts_streaming.yaml. GPU 메모리 비율은 장비별로 조정한다.
# TTS_ENGINE_CONFIG=/absolute/path/to/tts_streaming.yaml
# CUDA 13 nvcc는 새 환경에서 자동 선택한다. 별도 설치라면 아래 경로를 지정한다.
# TTS_ENGINE_CUDA_HOME=/absolute/path/to/cuda
# 복구: TTS_BACKEND=legacy (구절 전체 합성 후 전송, 기존 qwentts 환경 필요)
