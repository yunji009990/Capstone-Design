# Copy to dialogue.env (ignored by git). Use the same token as the Unity client.
DIALOGUE_TOKEN=
DIALOGUE_HOST=0.0.0.0
DIALOGUE_PORT=8002
# Production reads registered people over the API, not a shared data directory.
DIALOGUE_PERSONA_URL=http://127.0.0.1:8000
DIALOGUE_PERSONA_TOKEN=replace-with-the-PERSONA_READ_TOKEN-value
# DIALOGUE_SESSIONS_DIR is only for isolated legacy test fixtures when the URL is unset.
# STT: 현재 운영은 Whisper large-v3(GPU)다. 설치: python setup_dialogue_models.py --whisper
# 값이 whisper 가 아니면 기본 모델 폴더도 함께 바뀐다. 실패해도 다른 백엔드로 넘어가지 않는다.
DIALOGUE_STT_BACKEND=whisper
DIALOGUE_STT_DEVICE=cuda
DIALOGUE_STT_COMPUTE_TYPE=float16
# DIALOGUE_MODEL_DIR=/home/crc_unity/dialogue-models/whisper-large-v3
# 되돌리기: DIALOGUE_STT_BACKEND=sensevoice 로 두면 기존 CPU 모델을 그대로 쓴다.
# DIALOGUE_MODEL_DIR=/home/crc_unity/dialogue-models/sensevoice
DIALOGUE_LLM_URL=http://127.0.0.1:8001/v1/chat/completions
DIALOGUE_LLM_MODEL=exaone
DIALOGUE_LLM_EXTRA='{"chat_template_kwargs":{"enable_thinking":false},"skip_special_tokens":false}'
# Initially use the deployed Gemma in thinking mode. A separate reasoning model
# can be selected by changing both the URL and model, without changing Unity.
DIALOGUE_REASON_URL=http://127.0.0.1:8001/v1/chat/completions
DIALOGUE_REASON_MODEL=exaone
DIALOGUE_REASON_EXTRA='{"chat_template_kwargs":{"enable_thinking":true},"skip_special_tokens":false}'
DIALOGUE_REASON_TOKENS=2048
DIALOGUE_SILENCE_MS=700
# 끼어들기로 답변을 바꿀 때 클라이언트가 구절 경계를 찾을 여유(ms). 0..1500 으로 자른다.
# 경계를 이 안에서 찾지 못하면 클라이언트가 짧게 감쇠해 멈추고 그 지점을 보고한다.
# 0 은 예전과 같은 즉시 멈춤이다. 멈춘 지점을 보고하지 않는 구형 클라이언트에는 쓰이지 않는다.
DIALOGUE_PAUSE_GRACE_MS=1200
DIALOGUE_MAX_CONNECTIONS=1
# 입력 검증: 확인된 사람 말에만 기존 답변을 멈춘다. 모델이 없으면 서버가 시작을 거절한다.
# 설치: python setup_dialogue_models.py --vad  (공식 파일 SHA256 고정 확인)
# DIALOGUE_VAD_MODEL=/home/crc_unity/dialogue-models/silero/silero_vad.onnx
# 실제 모델 단일변수 비교로 정한 값이다. 0.5·0.6은 잡음을 통과시켰다.
DIALOGUE_VAD_THRESHOLD=0.7
# Silero 가 돌려준 발화 구간 길이의 합계 하한. 모델의 min_speech_duration(0.2초)과
# 맞춘 값이며, 구간 길이에는 모델 패딩이 들어가므로 순수 발성 시간은 아니다.
DIALOGUE_MIN_SPEECH_MS=200
# 이 버전은 발화가 끝난 뒤에만 검증한다. 끼어들기는 말끝 무음 0.7초 뒤에 반영된다.
# 진단 로그(선택). 비우면 파일을 만들지 않는다. 전역 로깅 설정은 건드리지 않고
# dialogue.diagnostics 로거에만 회전 핸들러를 붙인다. 집계·코드만 남고 원문은 남지 않는다.
# DIALOGUE_DIAGNOSTICS_LOG=/home/crc_unity/capstone-server/logs/diagnostics.log
# Connection-scoped memory only; reset/disconnect clears it. No registration writes.
DIALOGUE_MEMORY_ENABLED=1
# Input tokens + answer budget + margin must fit the deployed vLLM context.
DIALOGUE_CONTEXT_TOKENS=8192
# 캐릭터 준비 때 Gemma 대사와 Qwen 음성을 캐시. 추론 대기 중 한 번 재생한다.
DIALOGUE_REACTIONS_ENABLED=1
# 되묻기·기억 삭제 안내를 캐릭터 말투로 미리 준비한다(서버 RAM 캐시, 음성 합성 없음).
# 0 으로 두면 짧은 기본 문장을 쓴다. 실제 턴에서 추가 모델 호출은 없다.
DIALOGUE_SYSTEM_LINES_ENABLED=1
# 등록 인물만 디스크 저장. 임시 테스트 인물은 서버 RAM에만 캐시한다.
# DIALOGUE_REACTION_CACHE_DIR=/home/crc_unity/capstone-server/reaction-cache
# Authenticated, temporary profiles for the Unity AI test scene. No registration writes.
DIALOGUE_ALLOW_TEST_MODE=1
# Voice mode restored on 2026-09-14; start the separate TTS worker first.
# Leave empty only for an intentionally isolated text-only test service.
DIALOGUE_TTS_URL=http://127.0.0.1:8003
DIALOGUE_TTS_TOKEN=replace-with-the-TTS_TOKEN-value
