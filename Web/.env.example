# Copy to Web/.env (ignored by git). Credentials are never committed.
# Web, registration API, and the Tripo worker belong to the platform domain.
SESSION_URL=http://127.0.0.1:8000
SESSION_TOKEN=
# Optional explicit data root, shared only by the web and model worker.
# SURVEY_DATA_DIR=/home/crc_unity/webapp/Survey/data

ADMIN_PASSWORD=
SURVEY_ACCESS_CODE=
TRIPO_API_KEY=
TRIPO_POSE=preset:sit
# 1 = convert every photo to a T-pose image (Tripo generate_image, +5 credits) before
# image_to_model, so hands touching the body do not drag clothing after rigging. 0 = off.
TRIPO_TPOSE=1
# 1 = T포즈 얼굴 자리에 원본 사진 얼굴을 옮겨 붙여 Tripo 가 보는 얼굴 픽셀을 늘린다.
# 사진 3장 중 1장에서만 뚜렷하게 좋아졌다(A +0.153 / B -0.042 / C +0.023, 노이즈 0.045).
# 라이브러리가 없거나 얼굴을 못 찾으면 그 단계만 건너뛴다. 0 = 끔.
TRIPO_FACE_TRANSPLANT=1
# 삼각형 상한. auto 로 두면 Tripo 가 정하는데 실측 195만면·79MB 라 Quest 에 못 올린다.
# 감축 도구를 서버에 넣기 전에는 숫자로 둔다.
TRIPO_FACE_LIMIT=50000
TRIPO_GEOMETRY_QUALITY=standard
# Missing Tripo credentials block queued generation; AI remains independent.
# Set the key from the authenticated admin settings, then retry the blocked job.

# Optional speaker-extraction Python. Empty uses the existing default.
NEMO_PY=

# ── 머리 경로 (사람마다 머리만 만들어 고정 몸통에 얹는다) ──────────────────────
# head 면 T포즈·리깅을 부르지 않는다. 몸통 자산과 Blender 가 둘 다 있어야 돌아가고,
# 하나라도 없으면 전신 경로로 내려가며 그 사유가 작업 기록(pipeline_note)에 남는다.
TRIPO_PIPELINE=head
# 머리를 얹을 리깅된 몸통 GLB. 이게 없으면 머리 경로를 쓸 수 없다.
HEAD_BODY_GLB=
# Blender 실행 파일. 자르기와 합치기를 배치로 돌린다.
BLENDER_BIN=
# MediaPipe 분할 모델(selfie_multiclass_256x256.tflite).
HEAD_CUTOUT_MODEL=
# 컷아웃 프레이밍. portrait 는 가로를 얼굴 기준으로 두고 세로만 머리끝까지 늘린다.
HEAD_CUTOUT_FIT=portrait
