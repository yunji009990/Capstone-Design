# 이 파일을 `.env` 로 복사해서 값을 채운다. `.env` 는 저장소에 올라가지 않는다.
#
#   copy .env.example .env
#
# 서버를 띄울 때 읽는다. 고친 뒤에는 껐다 켜야 반영된다.
# 이미 설정된 환경변수가 있으면 그쪽이 이긴다 — 한 번만 다르게 띄워보고 싶을 때를 위해서다.

# 3D 모델 생성. 비우면 stub 으로 건너뛴다(대화는 정상, 인물 모델만 안 뜬다).
# https://platform.tripo3d.ai 에서 발급. tsk_ 로 시작한다.
TRIPO_API_KEY=

# Raon 서버. 서버 start.sh 의 RAON_TOKEN 과 같아야 한다.
# 비워두면 app.py 의 기본값을 쓴다.
RAON_URL=http://220.69.208.201:8000
RAON_TOKEN=

# 관리자 페이지(/admin) 비밀번호. 비우면 기본값 dasibom-admin 이다 — 공개 전 반드시 바꿀 것.
ADMIN_PASSWORD=

# 등록 화면 접근 코드. 비우면 게이트 없음(교내망 전용일 때).
SURVEY_ACCESS_CODE=

# 화자 분리용 nemo_env 의 python.exe. 비우면 Web/extraction/nemo_env 를 쓴다.
# 보통 비워둔다.
NEMO_PY=
