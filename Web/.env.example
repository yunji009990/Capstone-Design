# 이 파일을 `.env` 로 복사해서 값을 채운다. `.env` 는 저장소에 올라가지 않는다.
#
#   copy .env.example .env
#
# 서버를 띄울 때 읽는다. 고친 뒤에는 껐다 켜야 반영된다.
# 이미 설정된 환경변수가 있으면 그쪽이 이긴다 — 한 번만 다르게 띄워보고 싶을 때를 위해서다.
#
# ── 주의: `키=` 는 「기본값 사용」이 아니다 ──────────────────────────────
# setdefault 로 올리기 때문에 값 없이 이름만 적으면 환경변수가 **빈 문자열로
# 설정된다.** 그러면 os.environ.get(키, 기본값) 이 기본값이 아니라 빈 문자열을
# 돌려준다. 기본값을 쓰고 싶으면 **줄 전체를 # 으로 막거나 지운다.**
# 아래에서 주석으로 막아 둔 것들이 그런 줄이다.

# 3D 모델 생성. 비우면 stub 으로 건너뛴다(대화는 정상, 인물 모델만 안 뜬다).
# https://platform.tripo3d.ai 에서 발급. tsk_ 로 시작한다.
TRIPO_API_KEY=

# Raon 서버. 서버 start.sh 의 RAON_TOKEN 과 같아야 한다.
# 값을 채우거나, 코드 기본값을 쓰려면 줄째로 막아 둔다.
# `RAON_TOKEN=` 으로 비워두면 X-Token 을 아예 안 보내서 서버가 전부 401 을 낸다.
RAON_URL=http://220.69.208.201:8000
#RAON_TOKEN=

# 관리자 페이지(/admin) 비밀번호. **공개 전 반드시 바꿀 것** — /admin 은 참여자
# 사진·목소리·설문의 내려받기와 완전삭제를 쥐고 있다.
# `ADMIN_PASSWORD=` 로 비워두면 비밀번호가 빈 문자열이 되어 **아무 것도 안 친 사람이
# 들어온다.** 기본값(dasibom-admin)을 쓰려면 줄째로 막아 둔다.
#ADMIN_PASSWORD=

# 등록 화면 접근 코드. 비우면 게이트 없음(교내망 전용일 때).
SURVEY_ACCESS_CODE=

# 등록 뒤 1세대 참조를 자동으로 만들어 바꿔 단다(기본 1). 등록이 32 -> 77초로
# 길어지는 대신 첫낱말이 새는 것이 19/45 -> 3/45 로 잡힌다.
# `RAON_BOOTSTRAP=` 으로 비워두면 "" != "1" 이라 조용히 꺼진다. 끄려면 0 을 적는다.
#RAON_BOOTSTRAP=1

# 화자 분리용 nemo_env 의 python.exe. 비우면 Web/extraction/nemo_env 를 쓴다.
# 이 줄은 비워도 안전하다(코드가 `or` 로 받는다). 보통 비워둔다.
NEMO_PY=
