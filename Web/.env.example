# Copy to Web/.env (ignored by git). Credentials are never committed.
# Web, registration API, and the Tripo worker belong to the platform domain.
SESSION_URL=http://127.0.0.1:8000
SESSION_TOKEN=
# Optional explicit data root, shared only by the web and model worker.
# SURVEY_DATA_DIR=/home/crc_unity/webapp/Survey/data

ADMIN_PASSWORD=
SURVEY_ACCESS_CODE=
TRIPO_API_KEY=
TRIPO_POSE=preset:sit
# 1 = convert every photo to a T-pose image (Tripo generate_image, +5 credits) before
# image_to_model, so hands touching the body do not drag clothing after rigging. 0 = off.
TRIPO_TPOSE=1
# Missing Tripo credentials block queued generation; AI remains independent.
# Set the key from the authenticated admin settings, then retry the blocked job.

# Optional speaker-extraction Python. Empty uses the existing default.
NEMO_PY=
